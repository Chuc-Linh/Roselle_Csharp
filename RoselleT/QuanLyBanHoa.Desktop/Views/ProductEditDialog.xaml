<ContentDialog
    x:Class="QuanLyBanHoa.Desktop.Views.ProductEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource QuicksandFont}"
    RequestedTheme="Light"
    Title="Thông Tin Sản Phẩm"
    PrimaryButtonText="Lưu lại"
    CloseButtonText="Hủy"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
        <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackground" Color="#22C55E"/>
        <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackgroundPointerOver" Color="#16A34A"/>
        <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackgroundPressed" Color="#15803D"/>
        <SolidColorBrush x:Key="ContentDialogPrimaryButtonForeground" Color="White"/>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Width="480" Padding="4">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Mã sản phẩm (*):" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                    <TextBox x:Name="TxtProductCode" PlaceholderText="VD: HH00028" CornerRadius="6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Tên sản phẩm (*):" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                    <TextBox x:Name="TxtProductName" PlaceholderText="VD: Bó Cẩm Tú Cầu Xinh Xắn" CornerRadius="6"/>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock Text="Loại sản phẩm (*):" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                <ComboBox x:Name="CmbProductType" HorizontalAlignment="Stretch"
                          DisplayMemberPath="ProductTypeName" SelectedValuePath="ProductTypeID" CornerRadius="6"/>
            </StackPanel>

            <!-- KHUNG GIÁ ĐÃ BỊ KHÓA (QUẢN LÝ RIÊNG Ở TRANG QUẢN LÝ GIÁ BÁN) -->
            <Border Background="#F1F5F9" CornerRadius="10" Padding="14" BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Giá vốn (VNĐ) (Khóa):" FontWeight="Bold" FontSize="13" Foreground="#64748B"/>
                            <TextBox x:Name="TxtCostPrice" IsReadOnly="True" Background="#E2E8F0" Foreground="#64748B" CornerRadius="6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Tỉ lệ lợi nhuận (%) (Khóa):" FontWeight="Bold" FontSize="13" Foreground="#64748B"/>
                            <TextBox x:Name="TxtProfitRate" IsReadOnly="True" Background="#E2E8F0" Foreground="#64748B" CornerRadius="6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Ô Giá bán hiển thị (Chỉ xem) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Giá bán hiện tại (Quản lý tại trang Quản lý Giá bán):" FontWeight="Bold" FontSize="13" Foreground="#64748B"/>
                        <TextBox x:Name="TxtSellingPrice"
                                 Text="0 VNĐ"
                                 IsReadOnly="True"
                                 FontWeight="Bold"
                                 Foreground="#64748B"
                                 Background="#E2E8F0"
                                 BorderBrush="#CBD5E1"
                                 CornerRadius="6"/>
                    </StackPanel>

                    <!-- Ô Số lượng tồn kho & Mức tồn tối thiểu -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Số lượng tồn kho:" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                            <TextBox x:Name="TxtStockQuantity"
                                     Text="0"
                                     IsReadOnly="True"
                                     FontWeight="SemiBold"
                                     Foreground="#64748B"
                                     Background="#F1F5F9"
                                     BorderBrush="#CBD5E1"
                                     CornerRadius="6"
                                     ToolTipService.ToolTip="Số lượng tồn kho được tự động cập nhật qua Phiếu nhập hàng và Đơn đặt hàng"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Mức tồn tối thiểu (*):" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                            <TextBox x:Name="TxtMinStock" Text="5" CornerRadius="6" Background="White"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ĐƠN VỊ TÍNH (DẠNG CHỌN) - MÀU SẮC - NHÀ CUNG CẤP -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Đơn vị tính (*):" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                    <ComboBox x:Name="CmbUnit" HorizontalAlignment="Stretch" Height="32" CornerRadius="6">
                        <ComboBoxItem Content="Bó"/>
                        <ComboBoxItem Content="Giỏ"/>
                        <ComboBoxItem Content="Lẵng"/>
                        <ComboBoxItem Content="Hộp"/>
                        <ComboBoxItem Content="Bình"/>
                        <ComboBoxItem Content="Cành"/>
                        <ComboBoxItem Content="Chậu"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Màu sắc:" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                    <TextBox x:Name="TxtColor" PlaceholderText="Hồng, Trắng..." CornerRadius="6"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Nhà cung cấp:" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                    <TextBox x:Name="TxtSupplier" PlaceholderText="Tên NCC" CornerRadius="6"/>
                </StackPanel>
            </Grid>

            <!-- HÌNH ẢNH SẢN PHẨM -->
            <StackPanel Spacing="4">
                <TextBlock Text="Hình ảnh sản phẩm:" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtImage" PlaceholderText="Đường dẫn hoặc tên file ảnh" CornerRadius="6" Grid.Column="0" TextChanged="TxtImage_TextChanged"/>
                    <Button Content="Chọn ảnh..." Click="BtnBrowseImage_Click" CornerRadius="6" Grid.Column="1" Background="#F1F5F9" Foreground="#1B2432" BorderThickness="0" Height="32"/>
                    <Button Content="Xóa ảnh" Click="BtnRemoveImage_Click" CornerRadius="6" Grid.Column="2" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Height="32"/>
                </Grid>
                <Border CornerRadius="6" HorizontalAlignment="Left" Margin="0,6,0,0">
                    <Image x:Name="ImgPreview" Height="90" Stretch="Uniform"/>
                </Border>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Mô tả sản phẩm:" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                <TextBox x:Name="TxtDescription" AcceptsReturn="True" TextWrapping="Wrap" Height="65" CornerRadius="6"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Trạng thái kinh doanh:" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                <ToggleSwitch x:Name="TglStatus" IsOn="True" OnContent="Đang kinh doanh" OffContent="Ngừng bán"/>
            </StackPanel>

            <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>