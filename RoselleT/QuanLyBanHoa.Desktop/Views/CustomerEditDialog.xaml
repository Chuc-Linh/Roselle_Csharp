<ContentDialog
    x:Class="QuanLyBanHoa.Desktop.Views.CustomerEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource QuicksandFont}"
    RequestedTheme="Light"
    Title="Chỉnh Sửa Người Dùng"
    PrimaryButtonText="Lưu lại"
    CloseButtonText="Hủy"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
        <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackground" Color="#22C55E"/>
        <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackgroundPointerOver" Color="#16A34A"/>
        <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackgroundPressed" Color="#15803D"/>
        <SolidColorBrush x:Key="ContentDialogPrimaryButtonForeground" Color="White"/>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Width="480" Padding="4">

            <!-- TÊN ĐĂNG NHẬP & VAI TRÒ -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Tên đăng nhập (*):" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                    <TextBox x:Name="TxtUsername" PlaceholderText="Điền tên đăng nhập" CornerRadius="6"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Vai trò (*):" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                    <ComboBox x:Name="CbRole" HorizontalAlignment="Stretch" CornerRadius="6">
                        <ComboBoxItem Content="QuanTriVien"/>
                        <ComboBoxItem Content="KhachHang"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- HỌ VÀ TÊN -->
            <StackPanel Spacing="4">
                <TextBlock Text="Họ và tên (*):" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                <TextBox x:Name="TxtFullName" PlaceholderText="Điền họ và tên" CornerRadius="6"/>
            </StackPanel>

            <!-- KHUNG MẬT KHẨU -->
            <Border Background="#F8FAFC" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="LblPassword" Text="Mật khẩu (*):" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                    <PasswordBox x:Name="TxtPassword"
                                 PlaceholderText="Đã khóa - Không được phép đổi mật khẩu"
                                 CornerRadius="6"/>
                </StackPanel>
            </Border>

            <!-- EMAIL & SỐ ĐIỆN THOẠI -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Email (*):" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                    <TextBox x:Name="TxtEmail" PlaceholderText="VD: tenban@gmail.com" CornerRadius="6"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Số điện thoại (*):" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                    <TextBox x:Name="TxtPhone" MaxLength="10" PlaceholderText="VD: 0901234567" CornerRadius="6" BeforeTextChanging="TxtPhone_BeforeTextChanging"/>
                </StackPanel>
            </Grid>

            <!-- KHU VỰC ĐỊA CHỈ: SỐ NHÀ TÊN ĐƯỜNG + PHƯỜNG SAU SÁP NHẬP + TỈNH/THÀNH PHỐ SAU SÁP NHẬP -->
            <Border Background="#F8FAFC" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Địa chỉ liên hệ (*):" FontWeight="Bold" FontSize="13" Foreground="#1B2432"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Tỉnh / Thành phố (*):" FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                            <ComboBox x:Name="CbCity"
                                      HorizontalAlignment="Stretch"
                                      MaxDropDownHeight="320"
                                      PlaceholderText="Chọn Tỉnh/TP"
                                      CornerRadius="6"
                                      SelectionChanged="CbCity_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Phường (*):" FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                            <ComboBox x:Name="CbWard"
                                      HorizontalAlignment="Stretch"
                                      MaxDropDownHeight="320"
                                      PlaceholderText="Chọn Phường"
                                      CornerRadius="6"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Số nhà, tên đường (*):" FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                        <TextBox x:Name="TxtStreet" PlaceholderText="VD: 123 Nguyễn Huệ" CornerRadius="6" Background="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>