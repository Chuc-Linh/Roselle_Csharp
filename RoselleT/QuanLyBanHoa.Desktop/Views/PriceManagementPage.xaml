<Page
    x:Class="QuanLyBanHoa.Desktop.Views.PriceManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource QuicksandFont}"
    RequestedTheme="Light">

    <Grid Padding="28,24,28,28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Quản lý Giá bán &amp; Lợi nhuận" FontSize="22" FontWeight="Bold" Foreground="#1B2432"/>

        <!-- THANH TÌM KIẾM -->
        <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="20,16" BorderBrush="#E5E9F0" BorderThickness="1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtSearch" Grid.Column="0" PlaceholderText="Tìm theo mã hoặc tên sản phẩm..." Height="38" CornerRadius="8" TextChanged="TxtSearch_TextChanged"/>
                <TextBlock Grid.Column="1" Text="Lưu ý: Giá bán được hệ thống tính tự động dựa trên Giá vốn nhân với Tỉ lệ lợi nhuận quy định." VerticalAlignment="Center" Foreground="#64748B" FontStyle="Italic"/>
            </Grid>
        </Border>

        <!-- BẢNG DANH SÁCH GIÁ SẢN PHẨM -->
        <Border Grid.Row="2" Background="White" CornerRadius="16" Padding="20" BorderBrush="#E5E9F0" BorderThickness="1">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="14,12" Background="#1B2432" CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MÃ SP" FontSize="12" FontWeight="Bold" Foreground="White" Grid.Column="0" Margin="10,0,0,0"/>
                    <TextBlock Text="TÊN SẢN PHẨM" FontSize="12" FontWeight="Bold" Foreground="White" Grid.Column="1"/>
                    <TextBlock Text="GIÁ VỐN" FontSize="12" FontWeight="Bold" Foreground="White" Grid.Column="2" HorizontalAlignment="Right"/>
                    <TextBlock Text="LỢI NHUẬN (%)" FontSize="12" FontWeight="Bold" Foreground="White" Grid.Column="3" HorizontalAlignment="Center"/>
                    <TextBlock Text="GIÁ BÁN" FontSize="12" FontWeight="Bold" Foreground="White" Grid.Column="4" HorizontalAlignment="Right"/>
                    <TextBlock Text="THAO TÁC" FontSize="12" FontWeight="Bold" Foreground="White" Grid.Column="5" HorizontalAlignment="Center"/>
                </Grid>

                <ListView x:Name="PriceListView" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding ProductCode}" FontWeight="Bold" Foreground="#1B2432" Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="#334155" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding CostPriceText}" Foreground="#475569" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ProfitRateText}" FontWeight="Bold" Foreground="#D97706" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SellingPriceText}" FontWeight="Bold" Foreground="#059669" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <Button Grid.Column="5"
                                        Tag="{Binding ProductID}"
                                        Click="BtnEditPrice_Click"
                                        Height="32"
                                        Padding="12,0"
                                        CornerRadius="6"
                                        Background="#EEF2FF"
                                        Foreground="#1B2432"
                                        BorderThickness="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="#1B2432"/>
                                        <TextBlock Text="Đổi giá" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>