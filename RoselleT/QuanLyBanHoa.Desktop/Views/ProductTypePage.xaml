<Page
    x:Class="QuanLyBanHoa.Desktop.Views.ProductTypePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuanLyBanHoa.Desktop.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource QuicksandFont}"
    RequestedTheme="Light">

    <Grid Padding="28,24,28,28" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.6*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: DANH SÁCH LOẠI SẢN PHẨM -->
        <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="24" BorderBrush="#E5E9F0" BorderThickness="1">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Thanh tìm kiếm & Làm mới -->
                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtSearch"
                             Grid.Column="0"
                             PlaceholderText="Tìm kiếm theo tên loại hoa hoặc mô tả..."
                             FontFamily="{StaticResource QuicksandFont}"
                             Height="40"
                             CornerRadius="8"
                             Padding="12,8,12,8"
                             TextChanged="TxtSearch_TextChanged"/>

                    <Button x:Name="BtnRefresh"
                            Grid.Column="1"
                            Content="Làm mới"
                            FontFamily="{StaticResource QuicksandFont}"
                            FontWeight="SemiBold"
                            Height="40"
                            Padding="16,0"
                            CornerRadius="8"
                            Background="#F1F5F9"
                            Foreground="#1B2432"
                            BorderThickness="0"
                            Click="BtnRefresh_Click"/>
                </Grid>

                <!-- Tiêu đề bảng -->
                <Grid Grid.Row="1" Padding="14,10" Background="#F8FAFC" CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mã" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="0"/>
                    <TextBlock Text="Tên loại hoa" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="1"/>
                    <TextBlock Text="Mô tả" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="2"/>
                    <TextBlock Text="Số SP" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="3" HorizontalAlignment="Center"/>
                    <TextBlock Text="Trạng thái" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="4" HorizontalAlignment="Center"/>
                </Grid>

                <!-- Danh sách dữ liệu -->
                <ListView x:Name="TypeListView"
                          Grid.Row="2"
                          SelectionMode="Single"
                          SelectionChanged="TypeListView_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14,12" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="85"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProductTypeID}" FontWeight="Bold" Foreground="#64748B" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ProductTypeName}" FontWeight="Bold" Foreground="#1B2432" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Description}" Foreground="#475569" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ProductCount}" FontWeight="Bold" Foreground="#1B2432" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Background="{Binding StatusBg}" CornerRadius="6" Padding="8,4" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- CỘT PHẢI: FORM THÊM / CẬP NHẬT LOẠI HOA -->
        <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="24" BorderBrush="#E5E9F0" BorderThickness="1" VerticalAlignment="Top">
            <StackPanel Spacing="18">
                <TextBlock x:Name="TxtFormTitle"
                           Text="Thêm Loại Hoa Mới"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1B2432"/>

                <StackPanel Spacing="6">
                    <TextBlock Text="Mã loại (Tự động)" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBox x:Name="TxtTypeId"
                             IsReadOnly="True"
                             PlaceholderText="Tự động sinh khi thêm mới"
                             FontFamily="{StaticResource QuicksandFont}"
                             Background="#F8FAFC"
                             CornerRadius="8"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Tên loại hoa (*)" FontSize="13" FontWeight="SemiBold" Foreground="#1B2432"/>
                    <TextBox x:Name="TxtTypeName"
                             PlaceholderText="VD: Hoa Cẩm Tú, Hoa Tulip..."
                             FontFamily="{StaticResource QuicksandFont}"
                             MaxLength="50"
                             CornerRadius="8"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Mô tả chi tiết" FontSize="13" FontWeight="SemiBold" Foreground="#1B2432"/>
                    <TextBox x:Name="TxtDescription"
                             PlaceholderText="Nhập mô tả cho danh mục hoa..."
                             FontFamily="{StaticResource QuicksandFont}"
                             MaxLength="200"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="90"
                             CornerRadius="8"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Trạng thái hoạt động" FontSize="13" FontWeight="SemiBold" Foreground="#1B2432"/>
                    <ToggleSwitch x:Name="TglStatus"
                                  OnContent="Đang kinh doanh (Hiển thị)"
                                  OffContent="Ngừng kinh doanh (Ẩn)"
                                  FontFamily="{StaticResource QuicksandFont}"
                                  IsOn="True"/>
                </StackPanel>

                <!-- Thông báo kết quả / lỗi -->
                <TextBlock x:Name="TxtMessage"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <!-- Các nút thao tác -->
                <Grid ColumnSpacing="10" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnSave"
                            Grid.Column="0"
                            Content="Thêm mới"
                            FontFamily="{StaticResource QuicksandFont}"
                            FontWeight="Bold"
                            HorizontalAlignment="Stretch"
                            Height="42"
                            CornerRadius="8"
                            Background="#1B2432"
                            Foreground="White"
                            BorderThickness="0"
                            Click="BtnSave_Click"/>

                    <Button x:Name="BtnClear"
                            Grid.Column="1"
                            Content="Làm mới form"
                            FontFamily="{StaticResource QuicksandFont}"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Stretch"
                            Height="42"
                            CornerRadius="8"
                            Background="#F1F5F9"
                            Foreground="#1B2432"
                            BorderThickness="0"
                            Click="BtnClear_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>