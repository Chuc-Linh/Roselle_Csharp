<Page
    x:Class="QuanLyBanHoa.Desktop.Views.ReceiptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuanLyBanHoa.Desktop.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource QuicksandFont}"
    RequestedTheme="Light">

    <Grid Padding="28,24,28,28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- THANH CÔNG CỤ TÌM KIẾM & LỌC -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <TextBox x:Name="TxtSearch"
                         PlaceholderText="Tìm theo mã phiếu hoặc ghi chú..."
                         Width="280" Height="40" CornerRadius="8"
                         TextChanged="TxtSearch_TextChanged"/>

                <ComboBox x:Name="CmbFilterStatus"
                          Width="190" Height="40" CornerRadius="8"
                          SelectionChanged="CmbFilterStatus_SelectionChanged">
                    <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True"/>
                    <ComboBoxItem Content="Chưa hoàn thành"/>
                    <ComboBoxItem Content="Đã hoàn thành"/>
                </ComboBox>

                <Button x:Name="BtnRefresh"
                        Content="Làm mới"
                        FontWeight="SemiBold"
                        Height="40" Padding="16,0" CornerRadius="8"
                        Background="#F1F5F9" Foreground="#1B2432" BorderThickness="0"
                        Click="BtnRefresh_Click"/>
            </StackPanel>

            <Button x:Name="BtnAddReceipt"
                    Grid.Column="1"
                    Content="+ Tạo phiếu nhập mới"
                    FontWeight="Bold"
                    Height="40" Padding="18,0" CornerRadius="8"
                    Background="#1B2432" Foreground="White" BorderThickness="0"
                    Click="BtnAddReceipt_Click"/>
        </Grid>

        <!-- NỘI DUNG CHÍNH: 2 CỘT -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: DANH SÁCH PHIẾU NHẬP HÀNG (CÓ CỘT NGÀY TẠO & NGÀY CHỐT RIÊNG) -->
            <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20" BorderBrush="#E5E9F0" BorderThickness="1">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Danh sách Phiếu Nhập" FontSize="17" FontWeight="Bold" Foreground="#1B2432"/>

                    <!-- Tiêu đề cột -->
                    <Grid Grid.Row="1" Padding="10,10" Background="#F8FAFC" CornerRadius="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="108"/>
                            <ColumnDefinition Width="68"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mã PN" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="0"/>
                        <TextBlock Text="Ngày tạo" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="1"/>
                        <TextBlock Text="Ngày chốt" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="2"/>
                        <TextBlock Text="Ghi chú" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="3"/>
                        <TextBlock Text="Tổng tiền" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="4"/>
                        <TextBlock Text="Trạng thái" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="5" HorizontalAlignment="Center"/>
                        <TextBlock Text="Thao tác" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="6" HorizontalAlignment="Center"/>
                    </Grid>

                    <!-- Danh sách phiếu nhập -->
                    <ListView x:Name="ReceiptListView"
                              Grid.Row="2"
                              SelectionMode="Single"
                              SelectionChanged="ReceiptListView_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="108"/>
                                        <ColumnDefinition Width="68"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding ReceiptCode}" FontWeight="Bold" Foreground="#64748B" FontSize="12" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ImportDateText}" Foreground="#334155" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CompletedDateText}" Foreground="{Binding CompletedDateFg}" FontWeight="SemiBold" FontSize="12" Grid.Column="2" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Note}" Foreground="#475569" FontSize="12" Grid.Column="3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" ToolTipService.ToolTip="{Binding Note}"/>
                                    <TextBlock Text="{Binding TotalAmountText}" FontWeight="SemiBold" Foreground="#059669" FontSize="12" Grid.Column="4" VerticalAlignment="Center"/>

                                    <Border Background="{Binding StatusBg}" CornerRadius="6" Padding="7,3" Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg}" FontSize="11" FontWeight="Bold"/>
                                    </Border>

                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Tag="{Binding ReceiptID}" Click="BtnEditReceipt_Click" Visibility="{Binding ActionVisibility}" Height="28" Width="28" Padding="0" CornerRadius="6" Background="#22C55E" Foreground="White" BorderThickness="0" ToolTipService.ToolTip="Sửa phiếu nhập">
                                            <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                                        </Button>
                                        <Button Tag="{Binding ReceiptID}" Click="BtnDeleteReceipt_Click" Visibility="{Binding ActionVisibility}" Height="28" Width="28" Padding="0" CornerRadius="6" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" ToolTipService.ToolTip="Xóa phiếu nhập nháp">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- CỘT PHẢI: CHI TIẾT PHIẾU NHẬP & CỘNG KHO -->
            <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="20" BorderBrush="#E5E9F0" BorderThickness="1">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header chi tiết -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock x:Name="TxtDetailTitle" Text="Chi tiết phiếu nhập" FontSize="17" FontWeight="Bold" Foreground="#1B2432"/>
                            <TextBlock x:Name="TxtDetailSub" Text="Chọn một phiếu nhập bên trái để xem chi tiết" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button x:Name="BtnCompleteReceipt"
                                Grid.Column="1"
                                Content="Hoàn thành &amp; Cộng kho"
                                FontWeight="Bold"
                                Height="38" Padding="14,0" CornerRadius="8"
                                Background="#059669" Foreground="White" BorderThickness="0"
                                Visibility="Collapsed"
                                Click="BtnCompleteReceipt_Click"/>
                    </Grid>

                    <!-- Tiêu đề bảng chi tiết -->
                    <Grid Grid.Row="1" Padding="12,10" Background="#F8FAFC" CornerRadius="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tên sản phẩm" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="0"/>
                        <TextBlock Text="SL" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="1" HorizontalAlignment="Center"/>
                        <TextBlock Text="Giá nhập" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="2"/>
                        <TextBlock Text="Thành tiền" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="3"/>
                        <TextBlock Text="Thao tác" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="4" HorizontalAlignment="Center"/>
                    </Grid>

                    <!-- Danh sách chi tiết phiếu nhập -->
                    <ListView x:Name="DetailListView"
                              Grid.Row="2"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="#1B2432" Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Quantity}" FontWeight="Bold" Foreground="#334155" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ImportPriceText}" Foreground="#64748B" Grid.Column="2" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" Foreground="#059669" Grid.Column="3" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ActionVisibility}">
                                        <Button Tag="{Binding ProductID}" Click="BtnEditDetail_Click" Height="28" Width="28" Padding="0" CornerRadius="6" Background="#22C55E" Foreground="White" BorderThickness="0" ToolTipService.ToolTip="Sửa số lượng / giá nhập">
                                            <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                                        </Button>
                                        <Button Tag="{Binding ProductID}" Click="BtnDeleteDetail_Click" Height="28" Width="28" Padding="0" CornerRadius="6" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" ToolTipService.ToolTip="Xóa mặt hàng khỏi phiếu">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Footer tổng tiền, thêm chi tiết & thông báo -->
                    <StackPanel Grid.Row="3" Spacing="10" Margin="0,4,0,0">
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="Tổng tiền phiếu nhập:" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTotalReceiptAmount" Text="0 đ" FontSize="16" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="TxtMessage" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>

                        <Button x:Name="BtnAddDetail"
                                Content="+ Thêm mặt hàng vào phiếu nhập"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Stretch"
                                Height="38" CornerRadius="8"
                                Background="#F1F5F9" Foreground="#1B2432" BorderThickness="0"
                                Visibility="Collapsed"
                                Click="BtnAddDetail_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>