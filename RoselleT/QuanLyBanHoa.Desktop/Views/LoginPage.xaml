<Page
    FontFamily="{StaticResource QuicksandFont}"
    x:Class="QuanLyBanHoa.Desktop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuanLyBanHoa.Desktop.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Tắt toàn bộ màu nền và viền khi đưa chuột (hover) hoặc click vào TextBox/PasswordBox -->
    <Page.Resources>
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlForeground" Color="#1B2432"/>
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#1B2432"/>
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1B2432"/>
    </Page.Resources>

    <Grid Background="#0F141C">
        <!-- 1. Hình nền bên ngoài (hinhnen1.jpg) và lớp kính làm mờ nhòe Gaussian Blur -->
        <Image Source="ms-appx:///Images/hinhnen1.jpg"
               Stretch="UniformToFill"/>

        <!-- Lớp phủ AcrylicBrush tạo hiệu ứng nhòe mờ (Blur) hệt như hình mẫu Roselle Flowers -->
        <Border>
            <Border.Background>
                <AcrylicBrush TintColor="#0F141C"
                              TintOpacity="0.1"
                              TintLuminosityOpacity="0.1"
                              FallbackColor="#800F141C"/>
            </Border.Background>
        </Border>

        <!-- 2. Khung thẻ Đăng nhập màu trắng ở giữa -->
        <Border Width="430"
                Background="White"
                CornerRadius="24"
                Padding="45,38,45,42"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RequestedTheme="Light">

            <StackPanel Spacing="18">
                <!-- Logo Roselle -->
                <Image Source="ms-appx:///Images/logo.png"
                       Height="52"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,2"/>

                <!-- Tiêu đề Đăng nhập -->
                <TextBlock Text="Đăng nhập"
                           FontFamily="{StaticResource QuicksandFont}"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#1B2432"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <!-- Ô NHẬP 1: TÊN NGƯỜI DÙNG (Floating Label như Hình 2) -->
                <Grid Height="56" Background="Transparent" PointerPressed="UsernameBox_PointerPressed">
                    <!-- Nhãn chữ tự động nhảy lên khi click -->
                    <TextBlock x:Name="LblUsername"
                               Text="Tên người dùng"
                               FontFamily="{StaticResource QuicksandFont}"
                               FontSize="14"
                               Foreground="#1B2432"
                               IsHitTestVisible="False"
                               VerticalAlignment="Top">
                        <TextBlock.RenderTransform>
                            <CompositeTransform x:Name="TransUsername" TranslateY="20"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <!-- Ô nhập thực tế -->
                    <TextBox x:Name="TxtUsername"
                             FontFamily="{StaticResource QuicksandFont}"
                             Margin="0,18,28,2"
                             Padding="0,4,0,4"
                             FontSize="14"
                             BorderThickness="0"
                             Background="Transparent"
                             GotFocus="TxtUsername_GotFocus"
                             LostFocus="TxtUsername_LostFocus"
                             TextChanged="TxtUsername_TextChanged"
                             KeyDown="Input_KeyDown"/>

                    <!-- Icon người dùng bên phải -->
                    <FontIcon Glyph="&#xE77B;"
                              FontSize="15"
                              Foreground="#1B2432"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="0,0,4,10"
                              IsHitTestVisible="False"/>

                    <!-- Đường kẻ ngang bên dưới -->
                    <Border x:Name="LineUsername"
                            Height="1.5"
                            Background="#1B2432"
                            VerticalAlignment="Bottom"/>
                </Grid>

                <!-- Ô NHẬP 2: MẬT KHẨU (Floating Label như Hình 2) -->
                <Grid Height="56" Background="Transparent" PointerPressed="PasswordBox_PointerPressed">
                    <!-- Nhãn chữ tự động nhảy lên khi click -->
                    <TextBlock x:Name="LblPassword"
                               Text="Mật khẩu"
                               FontFamily="{StaticResource QuicksandFont}"
                               FontSize="14"
                               Foreground="#1B2432"
                               IsHitTestVisible="False"
                               VerticalAlignment="Top">
                        <TextBlock.RenderTransform>
                            <CompositeTransform x:Name="TransPassword" TranslateY="20"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <!-- Ô nhập mật khẩu thực tế -->
                    <PasswordBox x:Name="TxtPassword"
                                 FontFamily="{StaticResource QuicksandFont}"
                                 Margin="0,18,28,2"
                                 Padding="0,4,0,4"
                                 FontSize="14"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 GotFocus="TxtPassword_GotFocus"
                                 LostFocus="TxtPassword_LostFocus"
                                 PasswordChanged="TxtPassword_PasswordChanged"
                                 KeyDown="Input_KeyDown"/>

                    <!-- Icon khóa bên phải -->
                    <FontIcon Glyph="&#xE72E;"
                              FontSize="15"
                              Foreground="#1B2432"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="0,0,4,10"
                              IsHitTestVisible="False"/>

                    <!-- Đường kẻ ngang bên dưới -->
                    <Border x:Name="LinePassword"
                            Height="1.5"
                            Background="#1B2432"
                            VerticalAlignment="Bottom"/>
                </Grid>

                <!-- Thông báo lỗi (nếu có) -->
                <TextBlock x:Name="TxtError"
                           FontFamily="{StaticResource QuicksandFont}"
                           Foreground="#D93025"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <!-- NÚT ĐĂNG NHẬP (Màu #1B2432 giống Hình 1, tắt hoàn toàn hiệu ứng hover) -->
                <Button x:Name="BtnLogin"
                        Content="Đăng nhập"
                        FontFamily="{StaticResource QuicksandFont}"
                        Click="BtnLogin_Click"
                        HorizontalAlignment="Stretch"
                        Height="44"
                        Margin="0,8,0,0"
                        Background="#1B2432"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        CornerRadius="8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontFamily="{TemplateBinding FontFamily}"
                                                  FontWeight="{TemplateBinding FontWeight}"
                                                  FontSize="{TemplateBinding FontSize}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>