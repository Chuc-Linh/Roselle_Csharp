<ContentDialog
    x:Class="QuanLyBanHoa.Desktop.Views.OrderDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource QuicksandFont}"
    RequestedTheme="Light"
    CloseButtonText="Đóng">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Width="740" Padding="4">

            <!-- TIÊU ĐỀ ĐƠN HÀNG -->
            <Grid BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7BF;" FontSize="20" Foreground="#1B2432"/>
                    <TextBlock x:Name="TxtDialogTitle" Text="Chi tiết đơn hàng #0" FontSize="20" FontWeight="Bold" Foreground="#1B2432"/>
                </StackPanel>

                <Border x:Name="BadgeStatusBorder" Background="#EEF2FF" CornerRadius="6" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtOrderStatus" Text="Chờ xử lý" FontWeight="Bold" FontSize="12" Foreground="#1B2432"/>
                </Border>
            </Grid>

            <!-- KHUNG THÔNG TIN KHÁCH HÀNG & GIAO NHẬN -->
            <Border Background="#F8FAFC" CornerRadius="12" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Người nhận:" FontWeight="Bold" Foreground="#475569" Width="95"/>
                            <TextBlock x:Name="TxtRecipientName" FontWeight="Bold" Foreground="#1B2432" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Điện thoại:" FontWeight="Bold" Foreground="#475569" Width="95"/>
                            <TextBlock x:Name="TxtRecipientPhone" Foreground="#334155"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Địa chỉ giao:" FontWeight="Bold" Foreground="#475569" Width="95"/>
                            <TextBlock x:Name="TxtShippingAddress" Foreground="#334155" TextWrapping="Wrap" Width="310"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Ghi chú:" FontWeight="Bold" Foreground="#475569" Width="95"/>
                            <TextBlock x:Name="TxtOrderNote" Foreground="#64748B" FontStyle="Italic" TextWrapping="Wrap" Width="310"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <TextBlock Text="Ngày đặt:" FontWeight="Bold" Foreground="#475569"/>
                            <TextBlock x:Name="TxtOrderDate" FontWeight="SemiBold" Foreground="#1B2432"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <TextBlock Text="Số mặt hàng:" FontWeight="Bold" Foreground="#475569"/>
                            <TextBlock x:Name="TxtItemCount" FontWeight="SemiBold" Foreground="#1B2432"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BẢNG DANH SÁCH SẢN PHẨM TRONG ĐƠN HÀNG -->
            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Background="White">
                <StackPanel>
                    <!-- Header bảng màu xanh dương tối #1B2432 đồng bộ -->
                    <Grid Background="#1B2432" Padding="14,10" CornerRadius="9,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="135"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ẢNH" FontWeight="Bold" FontSize="12" Foreground="White" Grid.Column="0" HorizontalAlignment="Center"/>
                        <TextBlock Text="SẢN PHẨM" FontWeight="Bold" FontSize="12" Foreground="White" Grid.Column="1"/>
                        <TextBlock Text="ĐVT" FontWeight="Bold" FontSize="12" Foreground="White" Grid.Column="2" HorizontalAlignment="Center"/>
                        <TextBlock Text="ĐƠN GIÁ" FontWeight="Bold" FontSize="12" Foreground="White" Grid.Column="3" HorizontalAlignment="Right"/>
                        <TextBlock Text="SỐ LƯỢNG" FontWeight="Bold" FontSize="12" Foreground="White" Grid.Column="4" HorizontalAlignment="Center"/>
                        <TextBlock Text="THÀNH TIỀN" FontWeight="Bold" FontSize="12" Foreground="White" Grid.Column="5" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Danh sách sản phẩm -->
                    <ListView x:Name="OrderDetailListView" SelectionMode="None" MaxHeight="260">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="14,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="135"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" Foreground="#1B2432" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ProductCode}" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Unit}" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding PriceText}" Foreground="#334155" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Quantity}" FontWeight="Bold" Foreground="#1B2432" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding SubTotalText}" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Dòng Tổng cộng cuối bảng -->
                    <Grid Padding="18,14" Background="#F8FAFC" CornerRadius="0,0,9,9">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <TextBlock Text="TỔNG CỘNG:" FontSize="16" FontWeight="Bold" Foreground="#1B2432" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtGrandTotal" Text="0 VNĐ" FontSize="18" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>