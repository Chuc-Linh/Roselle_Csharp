<Page
    x:Class="QuanLyBanHoa.Desktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuanLyBanHoa.Desktop.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource QuicksandFont}"
    RequestedTheme="Light">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,24,28,28" Spacing="24">

            <!-- 1. BANNER CHÀO MỪNG -->
            <Border Height="130" CornerRadius="18">
                <Grid>
                    <Image Source="ms-appx:///Images/hinhnen1.jpg" Stretch="UniformToFill"/>
                    <Border>
                        <Border.Background>
                            <AcrylicBrush TintColor="#1B2432"
                                          TintOpacity="0.55"
                                          TintLuminosityOpacity="0.4"
                                          FallbackColor="#991B2432"/>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Padding="32,0">
                        <TextBlock Text="Roselle Flowers — Trang Quản Trị"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Chọn hoa đẹp, giao nhanh — Theo dõi hoạt động kinh doanh và tồn kho theo thời gian thực."
                                   FontSize="14"
                                   Foreground="#E2E8F0"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. BỐN THẺ THỐNG KÊ NHANH (KPI CARDS) -->
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Thẻ 1: Tổng Doanh Thu -->
                <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20" BorderBrush="#E5E9F0" BorderThickness="1">
                    <Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Text="TỔNG DOANH THU" FontSize="12" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtTotalRevenue" Text="0 đ" FontSize="22" FontWeight="Bold" Foreground="#1B2432"/>
                            <TextBlock Text="Tính trên các đơn hợp lệ" FontSize="12" Foreground="#10B981"/>
                        </StackPanel>
                        <Border Width="42" Height="42" CornerRadius="12" Background="#EEF2FF" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE8C7;" FontSize="18" Foreground="#1B2432"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Thẻ 2: Tổng Lợi Nhuận -->
                <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="20" BorderBrush="#E5E9F0" BorderThickness="1">
                    <Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Text="LỢI NHUẬN ƯỚC TÍNH" FontSize="12" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtTotalProfit" Text="0 đ" FontSize="22" FontWeight="Bold" Foreground="#059669"/>
                            <TextBlock Text="Giá bán trừ giá vốn &amp; giảm giá" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                        <Border Width="42" Height="42" CornerRadius="12" Background="#ECFDF5" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="#059669"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Thẻ 3: Đơn Hàng Mới -->
                <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="20" BorderBrush="#E5E9F0" BorderThickness="1">
                    <Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Text="ĐƠN HÀNG MỚI" FontSize="12" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtNewOrders" Text="0" FontSize="22" FontWeight="Bold" Foreground="#D97706"/>
                            <TextBlock x:Name="TxtTotalOrdersSub" Text="Trên tổng số 0 đơn hàng" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                        <Border Width="42" Height="42" CornerRadius="12" Background="#FFFBEB" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE7BF;" FontSize="18" Foreground="#D97706"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Thẻ 4: Cảnh Báo Tồn Kho -->
                <Border Grid.Column="3" Background="White" CornerRadius="16" Padding="20" BorderBrush="#E5E9F0" BorderThickness="1">
                    <Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Text="SẮP HẾT HÀNG" FontSize="12" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtLowStockCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#DC2626"/>
                            <TextBlock x:Name="TxtTotalProductsSub" Text="Trên tổng số 0 sản phẩm" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                        <Border Width="42" Height="42" CornerRadius="12" Background="#FEF2F2" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="#DC2626"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. HAI BẢNG DỮ LIỆU: ĐƠN HÀNG MỚI NHẤT & CẢNH BÁO TỒN KHO THẤP -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Bảng Trái: Đơn hàng gần đây (Đã bổ sung cột Khu vực Phường, TP) -->
                <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="22" BorderBrush="#E5E9F0" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock Text="Đơn hàng gần đây" FontSize="17" FontWeight="Bold" Foreground="#1B2432"/>
                            <TextBlock Text="5 đơn mới nhất" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Tiêu đề cột -->
                        <Grid Padding="12,8" Background="#F8FAFC" CornerRadius="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mã ĐH" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="0"/>
                            <TextBlock Text="Khách hàng" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="1"/>
                            <TextBlock Text="Phường, TP" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="2"/>
                            <TextBlock Text="Ngày đặt" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="3"/>
                            <TextBlock Text="Tổng tiền" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="4"/>
                            <TextBlock Text="Trạng thái" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="5"/>
                        </Grid>

                        <ItemsControl x:Name="RecentOrdersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding OrderCode}" FontWeight="Bold" Foreground="#1B2432" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CustomerName}" Foreground="#334155" FontWeight="SemiBold" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding ShippingArea}" Foreground="#475569" FontSize="12" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding CreatedDateText}" Foreground="#64748B" FontSize="12" Grid.Column="3" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalAmountText}" FontWeight="SemiBold" Foreground="#1B2432" FontSize="13" Grid.Column="4" VerticalAlignment="Center"/>
                                        <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OrderStatus}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusFg}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Bảng Phải: Sản phẩm cần nhập thêm -->
                <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="22" BorderBrush="#E5E9F0" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock Text="Cảnh báo tồn kho thấp" FontSize="17" FontWeight="Bold" Foreground="#1B2432"/>
                            <TextBlock Text="Tồn &lt;= Tối thiểu" FontSize="12" Foreground="#DC2626" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Padding="12,8" Background="#FEF2F2" CornerRadius="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mã SP" FontSize="12" FontWeight="Bold" Foreground="#991B1B" Grid.Column="0"/>
                            <TextBlock Text="Tên hoa" FontSize="12" FontWeight="Bold" Foreground="#991B1B" Grid.Column="1"/>
                            <TextBlock Text="Tồn" FontSize="12" FontWeight="Bold" Foreground="#991B1B" Grid.Column="2" HorizontalAlignment="Center"/>
                            <TextBlock Text="Tối thiểu" FontSize="12" FontWeight="Bold" Foreground="#991B1B" Grid.Column="3" HorizontalAlignment="Center"/>
                        </Grid>

                        <ItemsControl x:Name="LowStockList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ProductCode}" FontWeight="SemiBold" Foreground="#475569" FontSize="13" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ProductName}" Foreground="#1B2432" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding StockQuantity}" FontWeight="Bold" Foreground="#DC2626" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding MinStockLevel}" Foreground="#64748B" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TxtNoLowStock"
                                   Text="Tất cả sản phẩm đều đủ hàng trong kho!"
                                   Foreground="#059669"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>