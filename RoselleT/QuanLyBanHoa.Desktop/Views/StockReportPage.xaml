<Page
    x:Class="QuanLyBanHoa.Desktop.Views.StockReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource QuicksandFont}"
    RequestedTheme="Light">

    <Grid Padding="28,24,28,28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <TextBlock Grid.Row="0" Text="Báo cáo Nhập - Xuất - Tồn" FontSize="22" FontWeight="Bold" Foreground="#1B2432"/>

        <!-- THANH CÔNG CỤ LỌC -->
        <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="20,16" BorderBrush="#E5E9F0" BorderThickness="1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Từ ngày" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                    <CalendarDatePicker x:Name="DpFromDate" HorizontalAlignment="Stretch" Height="38" CornerRadius="8" DateChanged="DpFromDate_DateChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Đến ngày" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                    <CalendarDatePicker x:Name="DpToDate" HorizontalAlignment="Stretch" Height="38" CornerRadius="8" DateChanged="DpToDate_DateChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="Ngưỡng cảnh báo tồn" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                    <TextBox x:Name="TxtThreshold" Text="10" Height="38" CornerRadius="8" TextChanged="TxtThreshold_TextChanged"/>
                </StackPanel>

                <Button Grid.Column="3"
                        Content="Lọc báo cáo"
                        FontWeight="Bold"
                        Height="38"
                        Padding="24,0"
                        CornerRadius="8"
                        Background="#1B2432"
                        Foreground="White"
                        VerticalAlignment="Bottom"
                        BorderThickness="0"
                        Click="BtnFilter_Click"/>
            </Grid>
        </Border>

        <!-- BẢNG DỮ LIỆU BÁO CÁO -->
        <Border Grid.Row="2" Background="White" CornerRadius="16" Padding="20" BorderBrush="#E5E9F0" BorderThickness="1">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header bảng -->
                <Grid Grid.Row="0" Padding="14,12" Background="#1B2432" CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SẢN PHẨM" FontSize="12" FontWeight="Bold" Foreground="White" Grid.Column="0" Margin="10,0,0,0"/>
                    <TextBlock Text="TỒN ĐẦU KỲ" FontSize="12" FontWeight="Bold" Foreground="White" Grid.Column="1" HorizontalAlignment="Center"/>
                    <TextBlock Text="NHẬP TRONG KỲ" FontSize="12" FontWeight="Bold" Foreground="White" Grid.Column="2" HorizontalAlignment="Center"/>
                    <TextBlock Text="XUẤT TRONG KỲ" FontSize="12" FontWeight="Bold" Foreground="White" Grid.Column="3" HorizontalAlignment="Center"/>
                    <TextBlock Text="TỒN CUỐI KỲ" FontSize="12" FontWeight="Bold" Foreground="White" Grid.Column="4" HorizontalAlignment="Center"/>
                    <TextBlock Text="TRẠNG THÁI" FontSize="12" FontWeight="Bold" Foreground="White" Grid.Column="5" HorizontalAlignment="Center"/>
                </Grid>

                <!-- Danh sách dữ liệu -->
                <ListView x:Name="ReportListView" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding ProductName}" FontWeight="Bold" Foreground="#1B2432"/>
                                    <TextBlock Text="{Binding ProductCode}" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>

                                <TextBlock Text="{Binding OpeningStock}" FontWeight="Bold" Foreground="#334155" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ImportQty}" FontWeight="Bold" Foreground="#059669" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ExportQty}" FontWeight="Bold" Foreground="#D97706" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ClosingStockText}" FontWeight="Bold" FontSize="13" Foreground="{Binding ClosingStockFg}" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <Border Background="{Binding StatusBg}" CornerRadius="6" Padding="10,4" Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>