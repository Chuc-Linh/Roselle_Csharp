<ContentDialog
    x:Class="QuanLyBanHoa.Desktop.Views.ReceiptDetailAddDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource QuicksandFont}"
    RequestedTheme="Light"
    Title="Thêm Mặt Hàng Nhập Kho"
    PrimaryButtonText="Lưu lại"
    CloseButtonText="Hủy"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">
    

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">540</x:Double>
        <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackground" Color="#22C55E"/>
        <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackgroundPointerOver" Color="#16A34A"/>
        <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackgroundPressed" Color="#15803D"/>
        <SolidColorBrush x:Key="ContentDialogPrimaryButtonForeground" Color="White"/>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" Width="460" Padding="4,8,4,4">

        <!-- 1. KHUNG TÌM KIẾM & CHỌN SẢN PHẨM -->
        <StackPanel Spacing="8">
            <TextBlock Text="1. Thông tin mặt hàng" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
            <Border Background="#F8FAFC" CornerRadius="10" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel Spacing="14">

                    <!-- Ô tìm kiếm nhanh -->
                    <StackPanel x:Name="SearchPanel" Spacing="6">
                        <TextBlock Text="Tìm kiếm nhanh sản phẩm:" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                        <TextBox x:Name="TxtSearchProduct"
                                 PlaceholderText="Gõ mã hoặc tên sản phẩm để lọc..."
                                 CornerRadius="8"
                                 Height="38"
                                 Padding="12,8"
                                 Background="White"
                                 BorderBrush="#CBD5E1"
                                 TextChanged="TxtSearchProduct_TextChanged"/>
                    </StackPanel>

                    <!-- Chọn sản phẩm từ danh sách -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Chọn sản phẩm (*):" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                        <ComboBox x:Name="CmbProducts"
                                  HorizontalAlignment="Stretch"
                                  Height="38"
                                  DisplayMemberPath="ProductName"
                                  SelectedValuePath="ProductID"
                                  CornerRadius="8"
                                  Background="White"
                                  BorderBrush="#CBD5E1"
                                  SelectionChanged="CmbProducts_SelectionChanged"/>

                        <!-- Khung hiển thị thông tin tồn kho & giá vốn hiện tại -->
                        <Border Background="#FFFFFF" CornerRadius="6" Padding="10,8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="#059669" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtProductHint" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 2. KHUNG SỐ LƯỢNG & ĐƠN GIÁ NHẬP -->
        <StackPanel Spacing="8">
            <TextBlock Text="2. Số lượng &amp; Đơn giá nhập" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
            <Border Background="#F8FAFC" CornerRadius="10" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Số lượng (*):" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                        <TextBox x:Name="TxtQuantity"
                                 Text="20"
                                 Height="38"
                                 Padding="12,8"
                                 CornerRadius="8"
                                 Background="White"
                                 BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Giá nhập (VNĐ) (*):" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                        <TextBox x:Name="TxtImportPrice"
                                 PlaceholderText="200,000"
                                 Height="38"
                                 Padding="12,8"
                                 CornerRadius="8"
                                 Background="White"
                                 BorderBrush="#CBD5E1"
                                 TextChanged="TxtPrice_TextChanged"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- THÔNG BÁO LỖI (NẾU CÓ) -->
        <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>

    </StackPanel>
</ContentDialog>