<ContentDialog
    x:Class="QuanLyBanHoa.Desktop.Views.ReceiptAddDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource QuicksandFont}"
    RequestedTheme="Light">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="650" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Width="740" Padding="4">

            <!-- TIÊU ĐỀ HỘP THOẠI -->
            <Grid>
                <TextBlock x:Name="TxtDialogTitle" Text="Tạo Phiếu Nhập Hàng" FontSize="20" FontWeight="Bold" Foreground="#1B2432" VerticalAlignment="Center"/>
                <Button Content="Đóng" Click="BtnCancel_Click" HorizontalAlignment="Right" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" CornerRadius="6" Padding="14,6" FontWeight="SemiBold"/>
            </Grid>

            <!-- 1. THÔNG TIN PHIẾU NHẬP (CÓ NGÀY TẠO RIÊNG & NGÀY CHỐT RIÊNG) -->
            <StackPanel Spacing="10">
                <TextBlock Text="1. Thông tin phiếu nhập" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                <Border Background="#F8FAFC" CornerRadius="10" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Ngày tạo phiếu (*):" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                            <CalendarDatePicker x:Name="DpImportDate" HorizontalAlignment="Stretch" CornerRadius="6" Background="White"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Ngày chốt phiếu:" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                            <TextBox x:Name="TxtCompletedDateInfo"
                                     Text="Chưa chốt (Lưu nháp)"
                                     IsReadOnly="True"
                                     CornerRadius="6"
                                     Background="#E2E8F0"
                                     Foreground="#64748B"
                                     FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Ghi chú phiếu nhập:" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                            <TextBox x:Name="TxtNote" PlaceholderText="VD: Nhập lô hoa hồng Đà Lạt mới..." CornerRadius="6" Background="White"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 2. CHI TIẾT SẢN PHẨM NHẬP -->
            <StackPanel Spacing="12">
                <TextBlock Text="2. Chi tiết sản phẩm nhập" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>

                <!-- Ô tìm kiếm sản phẩm và thêm nhanh vào phiếu -->
                <AutoSuggestBox x:Name="AsbProductSearch"
                                PlaceholderText="Gõ mã hoặc tên sản phẩm để tìm và thêm vào phiếu..."
                                QueryIcon="Find"
                                CornerRadius="8"
                                TextChanged="AsbProductSearch_TextChanged"
                                SuggestionChosen="AsbProductSearch_SuggestionChosen"/>

                <!-- Bảng danh sách sản phẩm trong phiếu -->
                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="White">
                    <StackPanel>
                        <Grid Background="#F8FAFC" Padding="12,10" CornerRadius="7,7,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tên sản phẩm" FontWeight="Bold" FontSize="12" Foreground="#475569" Grid.Column="0" HorizontalAlignment="Center"/>
                            <TextBlock Text="Số lượng" FontWeight="Bold" FontSize="12" Foreground="#475569" Grid.Column="1" HorizontalAlignment="Center"/>
                            <TextBlock Text="Giá nhập (VNĐ)" FontWeight="Bold" FontSize="12" Foreground="#475569" Grid.Column="2" HorizontalAlignment="Center"/>
                            <TextBlock Text="Thành tiền" FontWeight="Bold" FontSize="12" Foreground="#475569" Grid.Column="3" HorizontalAlignment="Center"/>
                            <TextBlock Text="Xóa" FontWeight="Bold" FontSize="12" Foreground="#475569" Grid.Column="4" HorizontalAlignment="Center"/>
                        </Grid>

                        <Border x:Name="EmptyStateBorder" Padding="28" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                            <TextBlock Text="Chưa có sản phẩm nào. Hãy tìm kiếm ở trên!" Foreground="#64748B" FontSize="13" HorizontalAlignment="Center"/>
                        </Border>

                        <ListView x:Name="DraftDetailListView" SelectionMode="None" MaxHeight="240" Visibility="Collapsed">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding ProductName}" FontWeight="Bold" Foreground="#1B2432" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SubInfo}" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding QuantityText}"
                                                 Tag="{Binding ProductID}"
                                                 TextChanged="TxtRowQuantity_TextChanged"
                                                 HorizontalAlignment="Stretch"
                                                 Margin="4,0"
                                                 CornerRadius="6"
                                                 VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="2"
                                                 Text="{Binding ImportPriceText}"
                                                 Tag="{Binding ProductID}"
                                                 TextChanged="TxtRowPrice_TextChanged"
                                                 HorizontalAlignment="Stretch"
                                                 Margin="4,0"
                                                 CornerRadius="6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding AmountText}"
                                                   FontWeight="Bold"
                                                   Foreground="#059669"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>

                                        <Button Grid.Column="4"
                                                Tag="{Binding ProductID}"
                                                Click="BtnRemoveRow_Click"
                                                Height="30" Width="30" Padding="0" CornerRadius="6"
                                                Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Xóa dòng này">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid Padding="14,12" Background="#FAFAFA" CornerRadius="0,0,7,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="205"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tổng cộng:" FontWeight="Bold" FontSize="15" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock x:Name="TxtGrandTotal" Grid.Column="1" Text="0 VNĐ" FontWeight="Bold" FontSize="16" Foreground="#059669" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>

            <!-- NÚT LƯU NHÁP & CHỐT PHIẾU NHẬP -->
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="Hủy"
                        Click="BtnCancel_Click"
                        Height="40" Padding="18,0" CornerRadius="8"
                        Background="#F1F5F9" Foreground="#334155" BorderThickness="0"
                        FontWeight="Bold"/>

                <Button x:Name="BtnSaveDraft"
                        Content="Lưu nháp"
                        Click="BtnSaveDraft_Click"
                        Height="40" Padding="20,0" CornerRadius="8"
                        Background="#FBBF24" Foreground="#1B2432" BorderThickness="0"
                        FontWeight="Bold"/>

                <Button x:Name="BtnCompleteReceipt"
                        Content="Chốt phiếu nhập"
                        Click="BtnCompleteReceipt_Click"
                        Height="40" Padding="20,0" CornerRadius="8"
                        Background="#22C55E" Foreground="White" BorderThickness="0"
                        FontWeight="Bold"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>