<Window
    x:Class="QuanLyBanHoa.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuanLyBanHoa.Desktop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Roselle - Hệ Thống Quản Lý Bán Hoa (Admin)">

    <Grid Background="#F4F6F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. THANH SIDEBAR BÊN TRÁI -->
        <Border x:Name="SidebarPanel"
                Grid.Column="0"
                Width="250"
                Background="#1B2432"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo thương hiệu -->
                <StackPanel Grid.Row="0" Padding="15,22,15,14" Spacing="2" BorderBrush="#2D3748" BorderThickness="0,0,0,1">
                    <TextBlock x:Name="TxtLogoMain" Text="roselle"
                               FontFamily="{StaticResource QuicksandFont}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtLogoSub" Text="QUẢN TRỊ"
                               FontFamily="{StaticResource QuicksandFont}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#94A3B8"
                               CharacterSpacing="120"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Danh sách các mục Menu -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="10,14,10,0" Spacing="6">
                        <Button x:Name="BtnNavDashboard" Tag="Dashboard" Click="MenuButton_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="42" CornerRadius="8" Background="#2D3A4F" Foreground="White" BorderThickness="0" Padding="12,0"
                                ToolTipService.ToolTip="Trang chủ &amp; Thống kê">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE80F;" FontSize="15" Width="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Trang chủ &amp; Thống kê" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavProductTypes" Tag="ProductTypes" Click="MenuButton_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="42" CornerRadius="8" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="12,0"
                                ToolTipService.ToolTip="Loại sản phẩm">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8EC;" FontSize="15" Width="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Loại sản phẩm" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavProducts" Tag="Products" Click="MenuButton_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="42" CornerRadius="8" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="12,0"
                                ToolTipService.ToolTip="Quản lý Sản phẩm">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE7BF;" FontSize="15" Width="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Quản lý Sản phẩm" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavPrices" Tag="Prices" Click="MenuButton_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="42" CornerRadius="8" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="12,0"
                                ToolTipService.ToolTip="Quản lý Giá bán">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8AB;" FontSize="15" Width="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Quản lý Giá bán" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavReceipts" Tag="Receipts" Click="MenuButton_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="42" CornerRadius="8" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="12,0"
                                ToolTipService.ToolTip="Nhập hàng &amp; Tồn kho">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE896;" FontSize="15" Width="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Nhập hàng &amp; Tồn kho" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavStockReport" Tag="StockReport" Click="MenuButton_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="42" CornerRadius="8" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="12,0"
                                ToolTipService.ToolTip="Báo cáo Tồn kho">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE9D9;" FontSize="15" Width="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Báo cáo Tồn kho" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavStockWarning" Tag="StockWarning" Click="MenuButton_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="42" CornerRadius="8" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="12,0"
                                ToolTipService.ToolTip="Cảnh báo Sắp hết">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE7BA;" FontSize="15" Width="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Cảnh báo Sắp hết" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavOrders" Tag="Orders" Click="MenuButton_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="42" CornerRadius="8" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="12,0"
                                ToolTipService.ToolTip="Quản lý Đơn hàng">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8A1;" FontSize="15" Width="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Quản lý Đơn hàng" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNavCustomers" Tag="Customers" Click="MenuButton_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="42" CornerRadius="8" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="12,0"
                                ToolTipService.ToolTip="Khách hàng &amp; Tài khoản">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE716;" FontSize="15" Width="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Quản lý người dùng" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Nút Đăng xuất ở đáy Sidebar -->
                <Border Grid.Row="2" Padding="10,12" BorderBrush="#2D3748" BorderThickness="0,1,0,0">
                    <Button x:Name="BtnLogout" Click="BtnLogout_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Height="40" CornerRadius="8" Background="#3B1D27" Foreground="#FCA5A5" BorderThickness="0" Padding="12,0"
                            ToolTipService.ToolTip="Đăng xuất">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xF3B1;" FontSize="15" Width="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Đăng xuất" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- 2. KHUNG BÊN PHẢI -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Thanh Header phía trên -->
            <Border x:Name="TopHeaderBar"
                    Grid.Row="0"
                    Height="64"
                    Background="White"
                    Padding="20,0"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="BtnToggleSidebar" Click="BtnToggleSidebar_Click"
                                Width="36" Height="36" CornerRadius="8"
                                Background="#F1F5F9" Foreground="#1B2432" BorderThickness="0"
                                ToolTipService.ToolTip="Thu gọn / Mở rộng menu">
                            <FontIcon Glyph="&#xE700;" FontSize="15"/>
                        </Button>

                        <TextBlock x:Name="TxtPageTitle"
                                   Text="Trang chủ &amp; Thống kê"
                                   FontFamily="{StaticResource QuicksandFont}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#1B2432"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#1B2432">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="White"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtAdminName" Text="admin1" FontSize="13" FontWeight="Bold" Foreground="#1B2432"/>
                            <TextBlock Text="Quản trị viên" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Khung hiển thị các Page -->
            <Frame x:Name="ContentFrame" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>