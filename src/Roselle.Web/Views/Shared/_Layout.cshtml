@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentId = ViewContext.RouteData.Values["id"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Roselle Flowers</title>
    <link rel="icon" type="image/png" href="~/images/favicon.png">

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/cam-tu-cau.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/hoa-baby.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/hoa-hong.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/tulip.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/hoa-huongduong.css" asp-append-version="true">

    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600&display=swap" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <div class="header-left">
            <h1><a asp-controller="Home" asp-action="Index">roselle</a></h1>
        </div>

        <!-- Hamburger button (chỉ hiện trên mobile) -->
        <button class="hamburger" id="hamburgerBtn" aria-label="Menu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav class="header-center" id="navMenu">
            <ul>
                <li>
                    <a asp-controller="Home" asp-action="Index"
                       class="@(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                        Trang chủ
                    </a>
                </li>
                <li>
                    <a asp-controller="Product" asp-action="Category" asp-route-id="cam-tu"
                       class="@(currentId == "cam-tu" ? "active" : "")">
                        Hoa Cẩm Tú
                    </a>
                </li>
                <li>
                    <a asp-controller="Product" asp-action="Category" asp-route-id="tulip"
                       class="@(currentId == "tulip" ? "active" : "")">
                        Hoa Tulip
                    </a>
                </li>
                <li>
                    <a asp-controller="Product" asp-action="Category" asp-route-id="hong"
                       class="@(currentId == "hong" ? "active" : "")">
                        Hoa hồng
                    </a>
                </li>
                <li>
                    <a asp-controller="Product" asp-action="Category" asp-route-id="huong-duong"
                       class="@(currentId == "huong-duong" ? "active" : "")">
                        Hoa hướng dương
                    </a>
                </li>
                <li>
                    <a asp-controller="Product" asp-action="Category" asp-route-id="baby"
                       class="@(currentId == "baby" ? "active" : "")">
                        Hoa Baby
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Nút toggle dark mode -->
        <button class="theme-toggle" id="themeToggle" aria-label="Chuyển chế độ sáng/tối">
            <span class="theme-icon">🌙</span>
        </button>

        <!-- Khu vực user (chỉ 1 lần) -->
        <div class="header-right" id="user-area">
            @await Html.PartialAsync("_LoginPartial")
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer" role="contentinfo" aria-label="Chân trang">
        <div class="container footer-grid">
            <div class="brand">
                <h4>roselle</h4>
                <p>Roselle Flowers — hoa tươi cho mọi khoảnh khắc.</p>
                <p class="address">123 Đường Hoa, Quận A, TP. HCM</p>
            </div>
            <div class="contact">
                <p><strong>Hotline:</strong> <a href="tel:0123456789">0123 456 789</a></p>
                <p><strong>Email:</strong> <a href="mailto:info@roselle.example">info@roselle.example</a></p>
                <div class="social">
                    <a href="#" aria-label="Facebook">FB</a>
                    <a href="#" aria-label="Instagram">IG</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <small>© <span id="site-year"></span> Roselle Flowers. All rights reserved.</small>
        </div>
    </footer>

    <script>
        document.getElementById('site-year').textContent = new Date().getFullYear();
    </script>

    <!-- JS: Hamburger + Dark Mode -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // === 1. Hamburger menu ===
            const hamburger = document.getElementById('hamburgerBtn');
            const navMenu = document.getElementById('navMenu');

            if (hamburger && navMenu) {
                hamburger.addEventListener('click', function () {
                    hamburger.classList.toggle('active');
                    navMenu.classList.toggle('active');
                });

                // Đóng menu khi nhấn link
                navMenu.querySelectorAll('a').forEach(link => {
                    link.addEventListener('click', function () {
                        hamburger.classList.remove('active');
                        navMenu.classList.remove('active');
                    });
                });
            }

            // === 2. Dark Mode ===
            const html = document.documentElement;
            const toggle = document.getElementById('themeToggle');
            const icon = toggle ? toggle.querySelector('.theme-icon') : null;

            // Load theme đã lưu
            const savedTheme = localStorage.getItem('theme') || 'light';
            html.setAttribute('data-theme', savedTheme);
            if (icon) icon.textContent = savedTheme === 'dark' ? '☀️' : '🌙';

            // Toggle khi nhấn
            if (toggle) {
                toggle.addEventListener('click', function () {
                    const current = html.getAttribute('data-theme');
                    const next = current === 'dark' ? 'light' : 'dark';

                    html.setAttribute('data-theme', next);
                    localStorage.setItem('theme', next);
                    if (icon) icon.textContent = next === 'dark' ? '☀️' : '🌙';

                    // Hiện toast
                    if (typeof showToast === 'function') {
                        showToast(
                            next === 'dark' ? 'Đã bật chế độ tối ' : 'Đã bật chế độ sáng ',
                            'success'
                        );
                    }
                });
            }
        });
    </script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>