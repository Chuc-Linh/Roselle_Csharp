@model Roselle.Web.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<section class="cart-page container">
    <h1 class="page-title">Giỏ hàng của bạn</h1>

    @if (!Model.Items.Any())
    {
        <div class="cart-empty">
            <p>🛒 Giỏ hàng đang trống.</p>
            <a href="/" class="btn btn-primary">Tiếp tục mua hoa</a>
        </div>
    }
    else
    {
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr data-id="@item.CartItemID">
                        <td class="cart-product">
                            <img src="@item.Product?.ImageUrl" alt="@item.Product?.ProductName" />
                            <span>@item.Product?.ProductName</span>
                        </td>
                        <td class="cart-price">@item.UnitPrice.ToString("N0") ₫</td>
                        <td class="cart-qty">
                            <button class="qty-btn qty-minus">−</button>
                            <input type="number" class="qty-input" value="@item.Quantity" min="1" />
                            <button class="qty-btn qty-plus">+</button>
                        </td>
                        <td class="cart-subtotal">@item.SubTotal.ToString("N0") ₫</td>
                        <td>
                            <button class="btn-remove" title="Xóa">✕</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="cart-summary">
            <div class="cart-total">
                Tổng cộng: <strong id="cartTotal">@Model.TotalAmount.ToString("N0") ₫</strong>
            </div>
            <div class="cart-actions">
                <a href="/" class="btn btn-outline">Tiếp tục mua</a>
                <a href="/Order/Checkout" class="btn btn-primary">Tiến hành đặt hàng</a>
            </div>
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/cart.js"></script>
}