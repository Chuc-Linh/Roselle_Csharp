@{
    ViewData["Title"] = "Trang chủ";
}

<section class="hero" role="banner" aria-label="Hình nền chính">
    <div class="hero-content">
        <h2>Roselle Flowers</h2>
        <p>Chọn hoa đẹp, giao nhanh — Niềm vui trong từng bó hoa.</p>
    </div>
</section>

<section class="intro" aria-label="Giới thiệu ngắn">
    <div class="intro-grid container">
        <div class="intro-image" aria-hidden="true">
            <img src="~/images/gioithieu1.jpg" alt="Giới thiệu Roselle Flowers">
        </div>
        <div class="intro-text">
            <h3>Về Roselle</h3>
            <p>Roselle Flowers chuyên cung cấp hoa tươi cho mọi dịp: sinh nhật, kỷ niệm, xin lỗi hay tri ân. Chúng tôi cam kết chọn lựa kỹ càng, gói đẹp và giao nhanh trong ngày.</p>
            <p>Không chỉ mang đến những bó hoa rực rỡ, Roselle Flowers còn chú trọng vào ý nghĩa và cảm xúc mà mỗi cành hoa truyền tải.</p>
            <p>Với đội ngũ nghệ nhân cắm hoa giàu kinh nghiệm, Roselle Flowers tạo ra những thiết kế tinh tế, hiện đại nhưng vẫn giữ được nét truyền thống.</p>
            <p>Roselle Flowers tin rằng mỗi khoảnh khắc trong cuộc sống đều xứng đáng được tô điểm bằng sắc hoa.</p>
        </div>
    </div>
</section>

<section class="hot-flowers" aria-label="Hoa siêu hot">
    <div class="container">
        <h3 class="section-title">Hoa Siêu Hot</h3>

        <div class="hot-grid">
            <article class="product-card">
                <a class="product-link" href="/Product/Detail/1">
                    <div class="product-thumb" style="background-image:url('/images/camtu/camtu-hong.jpg')"></div>
                    <h4 class="product-title">Bó Cẩm Tú Cầu Mix Hồng</h4>
                    <div class="product-meta">Romantic • Gói sang</div>
                    <div class="product-price">₫380.000</div>
                </a>
            </article>

            <article class="product-card">
                <a class="product-link" href="/Product/Detail/2">
                    <div class="product-thumb" style="background-image:url('/images/baby/baby-xanh.jpg')"></div>
                    <h4 class="product-title">Bó Hoa Baby Xanh Pastel</h4>
                    <div class="product-meta">Màu nhẹ • Hiện đại</div>
                    <div class="product-price">₫260.000</div>
                </a>
            </article>

            <article class="product-card">
                <a class="product-link" href="/Product/Detail/3">
                    <div class="product-thumb" style="background-image:url('/images/rose/rose-red.jpg')"></div>
                    <h4 class="product-title">Bó Hoa Hồng Đỏ Cổ Điển</h4>
                    <div class="product-meta">Biểu tượng tình yêu</div>
                    <div class="product-price">₫450.000</div>
                </a>
            </article>

            <article class="product-card">
                <a class="product-link" href="/Product/Detail/4">
                    <div class="product-thumb" style="background-image:url('/images/tulip/tulip-trang.jpg')"></div>
                    <h4 class="product-title">Bó Tulip Trắng Thanh Khiết</h4>
                    <div class="product-meta">Thanh lịch • Tinh tế</div>
                    <div class="product-price">₫410.000</div>
                </a>
            </article>

            <article class="product-card">
                <a class="product-link" href="/Product/Detail/5">
                    <div class="product-thumb" style="background-image:url('/images/sun/sun1.jpg')"></div>
                    <h4 class="product-title">Bó Hướng Dương Rực Rỡ</h4>
                    <div class="product-meta">Tươi sáng • Lạc quan</div>
                    <div class="product-price">₫350.000</div>
                </a>
            </article>

            <article class="product-card">
                <a class="product-link" href="/Product/Detail/6">
                    <div class="product-thumb" style="background-image:url('/images/camtu/camtu-pastel.jpg')"></div>
                    <h4 class="product-title">Bó Cẩm Tú Cầu Pastel</h4>
                    <div class="product-meta">Dịu dàng • Tinh khôi</div>
                    <div class="product-price">₫390.000</div>
                </a>
            </article>
        </div>
    </div>
</section>