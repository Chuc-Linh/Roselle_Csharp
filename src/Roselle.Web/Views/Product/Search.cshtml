@model List<Roselle.Web.Models.Product>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Tìm kiếm";
    var query = ViewData["Query"] as string;
    var minPrice = ViewData["MinPrice"] as decimal?;
    var maxPrice = ViewData["MaxPrice"] as decimal?;
}

<section class="category-page container">
    <h1 class="page-title">Kết quả tìm kiếm: "@query"</h1>

    <!-- Hiển thị thông báo nếu đang lọc theo giá -->
    @if (minPrice.HasValue || maxPrice.HasValue)
    {
        <div style="text-align: center; margin-bottom: 20px; font-size: 14px; color: #666;">
            Đang lọc theo giá: 
            @(minPrice.HasValue ? $"Từ {minPrice.Value:N0}đ" : "")
            @(minPrice.HasValue && maxPrice.HasValue ? " - " : "")
            @(maxPrice.HasValue ? $"Đến {maxPrice.Value:N0}đ" : "")
            <a href="/Product/Search?q=@query" style="color: #9d4edd; text-decoration: none; margin-left: 10px;">(Xóa lọc)</a>
        </div>
    }

    <p style="text-align:center; color:#666; margin-bottom:30px;">
        Tìm thấy <strong>@Model.Count</strong> sản phẩm phù hợp.
    </p>

    @if (Model.Count == 0)
    {
        <div class="cart-empty">
            <p>Không tìm thấy sản phẩm nào.</p>
        </div>
    }
    else
    {
        <div class="hot-grid">
            @foreach (var product in Model)
            {
                <article class="product-card">
                    <a class="product-link" href="/Product/Detail/@product.ProductID">
                        <div class="product-thumb">
                            <img src="/@product.Image" alt="@product.ProductName" style="width:100%; height:100%; object-fit:cover; border-radius: 12px;" />
                        </div>
                        <h4 class="product-title">@product.ProductName</h4>
                        <div class="product-meta">@product.Description</div>
                        <div class="product-price">@product.SellingPrice.GetValueOrDefault().ToString("N0") ₫</div>
                    </a>
                </article>
            }
        </div>
    }
</section>